    join
        users u1_0 
            on u1_0.id=t1_0.user_id 
    join
        master_value s1_0 
            on s1_0.id=t1_0.status_id 
    left join
        work_item wi1_0 
            on wi1_0.id=te1_0.work_item_id 
    where
        t1_0.work_date>=? 
        and t1_0.work_date<=? 
        and s1_0.code='APPROVED' 
        and t1_0.active=true 
        and (
            cast(? as bigint) is null 
            or wi1_0.project_id=?
        ) 
        and (
            cast(? as bigint) is null 
            or t1_0.user_id=?
        ) 
        and (
            ?='' 
            or lower(u1_0.full_name) like lower(('%'||?||'%')) escape ''
        ) 
    order by
        t1_0.work_date desc,
        te1_0.start_time 
    fetch
        first ? rows only
